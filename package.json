{
  "name": "onenote-ferry",
  "version": "0.0.0",
  "private": true,
  "description": "Convert OneNote notebooks downloaded from OneDrive into Markdown for Obsidian, and keep them in sync.",
  "author": "AlcatrazYU",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:samples": "node --test tests/samples/run.check.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.plugin.json",
    "build:plugin": "node scripts/build-plugin.mjs",
    "convert": "node src/cli/main.ts",
    "build:parser": "cd parser/ferry && wasm-pack build --target nodejs --release --out-dir ../../build/parser-wasm --out-name ferry",
    "build:dump": "cargo build --release --manifest-path parser/Cargo.toml -p ferry --bin dump"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "7.0.2"
  }
}
